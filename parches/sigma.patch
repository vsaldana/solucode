+
+// Arte de marca: sigma blanco sobre el círculo turquesa, en medios bloques de terminal.
+const sigma = [
+  "  ccccc  ",
+  " cwwwwwc ",
+  "ccwwccccc",
+  "ccccwwccc",
+  "ccccwwccc",
+  "ccwwccccc",
+  " cwwwwwc ",
+  "  ccccc  ",
+]
+const coloresSigma: Record<string, string | undefined> = { c: "#00abc1", w: "#ffffff" }
+
+export function sigmaLine(row: number) {
+  return Array.from(sigma[row * 2], (pixel, column) => {
+    const bottom = sigma[row * 2 + 1][column]
+    return pixel === " "
+      ? { char: bottom === " " ? " " : "▄", fg: coloresSigma[bottom], bg: undefined }
+      : { char: "▀", fg: coloresSigma[pixel], bg: coloresSigma[bottom] }
+  })
+}
