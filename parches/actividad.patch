+import { expect, test } from "bun:test"
+import type { SessionMessageAssistant, SessionMessageAssistantTool } from "@opencode/client"
+import { currentActivity, toolActivity } from "../../src/util/activity"
+import { toolPreview } from "../../src/routes/session/activity-preview"
+
+const tool = (name: string, input: Record<string, string> = {}): SessionMessageAssistantTool => ({
+  type: "tool",
+  id: "tool",
+  name,
+  time: { created: 100 },
+  state: { status: "running", input, metadata: {} },
+})
+const assistant = (content: SessionMessageAssistant["content"]): SessionMessageAssistant => ({
+  type: "assistant",
+  id: "assistant",
+  agent: "build",
+  model: { id: "test", providerID: "test" },
+  time: { created: 100 },
+  content,
+})
+
+test("activity labels use actual stage and target without exposing reasoning", () => {
+  expect(currentActivity([], 100)).toBe("Esperando respuesta")
+  expect(currentActivity([assistant([{ type: "reasoning", text: "PRIVATE REASONING" }])], 100)).not.toContain("PRIVATE")
+  const edit = tool("edit", { path: "src/app.ts", oldString: "a", newString: "b" })
+  expect(currentActivity([assistant([edit])], 100)).toBe("Ejecutando edición · src/app.ts")
+  expect(currentActivity([assistant([edit])], 100, true)).toBe("Esperando permiso")
+  expect(currentActivity([assistant([edit])], 200)).toBe("Esperando respuesta")
+  expect(
+    currentActivity([assistant([edit]), { type: "idle", id: "end", outcome: "interrupted", time: { created: 101 } }]),
+  ).toBe("Esperando respuesta")
+  expect(toolActivity({ ...edit, state: { status: "streaming", input: "{" } })).toBe("Preparando edición")
+  expect(
+    currentActivity([
+      { ...assistant([]), retry: { attempt: 2, at: 200, error: { type: "UnknownError", message: "retry" } } },
+    ]),
+  ).toBe("Esperando reintento · intento 2")
+  expect(currentActivity([assistant([tool("question")])])).toBe("Esperando tu respuesta")
+})
+
+test("draft edits and partial arguments never claim to be applied", () => {
+  const edit = tool("edit", { path: "a.ts", oldString: "before", newString: "after" })
+  expect(toolPreview(edit)).toEqual({ title: "Cambio en curso · sin confirmar · a.ts", text: "- before\n+ after" })
+  expect(toolPreview({ ...edit, state: { status: "streaming", input: '{"newString":"partial' } })).toEqual({
+    title: "Argumentos parciales · sin ejecutar",
