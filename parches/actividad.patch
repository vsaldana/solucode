@@ -0,0 +1,102 @@
+import type { SessionMessageAssistantTool } from "@opencode/client"
+import { createMemo, Show } from "solid-js"
+import stripAnsi from "strip-ansi"
+import { useTheme } from "../../context/theme"
+import { parseApplyPatchFiles, parseScriptChanges } from "../../util/tool-changes"
+import { canonicalToolName, toolDisplayMetadata } from "../../util/tool-display"
+import { collapseToolOutput } from "../../util/collapse-tool-output"
+import { use } from "./render-context"
+
+const mutations = new Set(["edit", "write", "patch"])
+
+export function hasReportedChanges(part: SessionMessageAssistantTool) {
+  if (part.state.status === "streaming") return false
+  if (part.state.status === "completed" && mutations.has(canonicalToolName(part.name))) return true
+  return (
+    parseScriptChanges(part.state.metadata?.files).length > 0 ||
+    parseApplyPatchFiles(part.state.metadata?.files).length > 0
+  )
+}
+
+export function toolPreview(part: SessionMessageAssistantTool, draftOnly = false) {
+  const name = canonicalToolName(part.name)
+  if (part.state.status === "streaming")
+    return part.state.input
+      ? { title: "Argumentos parciales · sin ejecutar", text: part.state.input, tail: true }
+      : undefined
+  const metadata = toolDisplayMetadata(part.state)
+  const files = name === "execute" ? parseScriptChanges(metadata.files) : parseApplyPatchFiles(metadata.files)
+  if (files.length > 0) {
+    if (draftOnly) return
+    return {
+      title: `Cambios reportados · ${files.length} ${files.length === 1 ? "archivo" : "archivos"}`,
+      text: files
+        .slice(-2)
+        .map((file) => `${file.relativePath}\n${file.patch || "(sin vista de texto)"}`)
+        .join("\n"),
+    }
+  }
+  const input = part.state.input
+  const target = typeof input.path === "string" ? ` · ${input.path}` : ""
+  if (name === "write" && typeof input.content === "string") {
+    if (draftOnly && part.state.status !== "running") return
+    return {
+      title: `${part.state.status === "completed" ? "Contenido escrito" : "Cambio en curso · sin confirmar"}${target}`,
+      text: input.content,
+    }
+  }
+  if (part.state.status !== "running") return
+  if (name === "edit") {
+    const before = typeof input.oldString === "string" ? input.oldString : ""
+    const after = typeof input.newString === "string" ? input.newString : ""
+    return before || after
+      ? {
+          title: `Cambio en curso · sin confirmar${target}`,
+          text: [
+            collapseToolOutput(before, 3, 600)
+              .output.split("\n")
+              .map((line) => `- ${line}`)
+              .join("\n"),
+            collapseToolOutput(after, 3, 600)
+              .output.split("\n")
+              .map((line) => `+ ${line}`)
+              .join("\n"),
+          ].join("\n"),
+        }
+      : undefined
+  }
+  if (name === "patch" && typeof input.patchText === "string")
+    return { title: "Parche en curso · sin confirmar", text: input.patchText }
+  if (draftOnly) return
+  const output = typeof metadata.output === "string" ? metadata.output : ""
+  return output ? { title: "Salida parcial", text: output, tail: true } : undefined
+}
+
+export function ToolActivityPreview(props: { part: SessionMessageAssistantTool; draftOnly?: boolean }) {
+  const ctx = use()
+  const theme = useTheme()
+  const preview = createMemo(() => toolPreview(props.part, props.draftOnly))
+  const text = createMemo(() => {
+    const value = preview()
+    if (!value) return ""
+    const limit = 6 * Math.max(1, ctx.width - 5)
+    const clean = stripAnsi(value.text)
+    // Streamed arguments/output show their newest data; confirmed diffs start with the file and hunk.
+    const source = value.tail && clean.length > limit ? `…${clean.slice(-limit + 1)}` : clean
+    return collapseToolOutput(source, 6, limit).output
+  })
+  return (
+    <Show when={preview()}>
+      {(value) => (
+        <box paddingLeft={3} flexShrink={0}>
+          <text fg={theme.text.muted} wrapMode="word" maxHeight={2}>
+            {value().title}
+          </text>
+          <text fg={theme.text.base} wrapMode="char" maxHeight={6}>
+            {text()}
+          </text>
+        </box>
+      )}
+    </Show>
+  )
+}
