+import { createMemo, createSignal } from "solid-js"
+import { useData } from "../../context/data"
+import { useEvent } from "../../context/event"
+import { useTheme } from "../../context/theme"
+import { currentActivity } from "../../util/activity"
+import { createExecutionElapsed, executionStart } from "../../util/execution-progress"
+
+export function usePromptActivity(props: { sessionID?: string; visible?: boolean }) {
+  const data = useData()
+  const event = useEvent()
+  const [observed, setObserved] = createSignal<{ sessionID: string; started: number }>()
+  event.on("session.execution.started", (event) => {
+    if (event.data.sessionID === props.sessionID)
+      setObserved({ sessionID: event.data.sessionID, started: event.created })
+  })
+  const started = createMemo(() =>
+    executionStart(
+      data.session.get(props.sessionID ?? "")?.time,
+      observed()?.sessionID === props.sessionID ? observed()?.started : undefined,
+    ),
+  )
+  const active = () => props.visible !== false && data.session.status(props.sessionID ?? "") === "running"
+  const elapsed = createExecutionElapsed(() => ({ started: started(), active: active() }))
+  // Deliberately independent of the one-second clock: do not scan history on every tick.
+  const activity = createMemo(() =>
+    active()
+      ? currentActivity(
+          data.session.message.list(props.sessionID ?? ""),
+          started(),
+          (data.session.permission.list(props.sessionID ?? "")?.length ?? 0) > 0,
+        )
+      : "",
+  )
+  return { elapsed, activity }
+}
+
+export function PromptActivity(props: { elapsed: string; activity: string }) {
+  const theme = useTheme()
+  return (
+    <box flexDirection="row" gap={1} flexGrow={1} flexShrink={1} minWidth={props.elapsed.length}>
+      <text fg={theme.text.base} flexShrink={0}>
+        {props.elapsed}
+      </text>
+      <text fg={theme.text.muted} flexGrow={1} flexShrink={1} minWidth={0} wrapMode="none" truncate>
+        {props.activity}
+      </text>
+    </box>
+  )
+}
