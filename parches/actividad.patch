diff --git a/packages/tui/src/util/activity.ts b/packages/tui/src/util/activity.ts
new file mode 100644
index 0000000..1bbdbc8
--- /dev/null
+++ b/packages/tui/src/util/activity.ts
@@ -0,0 +1,54 @@
+import type { SessionMessageAssistantTool, SessionMessageInfo } from "@opencode/client"
+import { canonicalToolName, executeCalls } from "./tool-display"
+
+const names: Record<string, string> = {
+  shell: "comando",
+  execute: "código",
+  read: "lectura",
+  edit: "edición",
+  write: "escritura",
+  patch: "parche",
+  glob: "búsqueda de archivos",
+  grep: "búsqueda",
+  websearch: "búsqueda web",
+  webfetch: "consulta web",
+  subagent: "subagente",
+  todowrite: "lista de tareas",
+  skill: "instrucciones",
+}
+
+export function toolActivity(part: SessionMessageAssistantTool) {
+  const name = canonicalToolName(part.name)
+  if (name === "question" && part.state.status === "running") return "Esperando tu respuesta"
+  const call =
+    part.state.status === "running"
+      ? executeCalls(part.state.metadata?.toolCalls).findLast((item) => item.status === "running")
+      : undefined
+  const input = call?.input ?? (typeof part.state.input === "string" ? {} : part.state.input)
+  const target = [input.path, input.filePath, input.command, input.query, input.pattern].find(
+    (value): value is string => typeof value === "string" && value !== "",
+  )
+  const tool = call ? canonicalToolName(call.tool) : name
+  return `${part.state.status === "streaming" ? "Preparando" : "Ejecutando"} ${names[tool] ?? tool}${target ? ` · ${target.replace(/\s+/g, " ").slice(0, 160)}` : ""}`
+}
+
+/** Observed activity only. Reasoning contents never enter this label. */
+export function currentActivity(messages: readonly SessionMessageInfo[], started?: number, permission = false) {
+  if (permission) return "Esperando permiso"
+  for (let index = messages.length - 1; index >= 0; index--) {
+    const message = messages[index]
+    if (message.type === "idle" || (started !== undefined && message.time.created < started)) break
+    if (message.type === "compaction" && message.status === "running") return "Resumiendo contexto"
+    if (message.type !== "assistant") continue
+    if (message.retry) return `Esperando reintento · intento ${message.retry.attempt}`
+    const tool = message.content.findLast(
+      (part) => part.type === "tool" && (part.state.status === "streaming" || part.state.status === "running"),
+    )
+    if (tool?.type === "tool") return toolActivity(tool)
+    if (message.time.completed !== undefined) continue
+    if (message.content.some((part) => part.type === "text" && part.text)) return "Recibiendo respuesta"
+    if (message.time.firstToken !== undefined) return "Procesando respuesta"
+    return "Esperando respuesta"
+  }
+  return "Esperando respuesta"
+}
diff --git a/packages/tui/src/util/execution-progress.ts b/packages/tui/src/util/execution-progress.ts
new file mode 100644
index 0000000..54eb585
--- /dev/null
+++ b/packages/tui/src/util/execution-progress.ts
@@ -0,0 +1,33 @@
+import { createEffect, createMemo, createSignal, onCleanup, type Accessor } from "solid-js"
+
+export function executionStart(time: { busy?: number; idle?: number } | undefined, observed?: number) {
+  const busy = time?.busy
+  const stored = busy !== undefined && busy > (time?.idle ?? -Infinity) ? busy : undefined
+  return observed === undefined ? stored : Math.max(observed, stored ?? -Infinity)
+}
+
+export function elapsedTime(started: number | undefined, now: number) {
+  if (started === undefined) return "--:--"
+  const seconds = Math.max(0, Math.floor((now - started) / 1_000))
+  const minutes = Math.floor(seconds / 60)
+  return `${minutes}:${String(seconds % 60).padStart(2, "0")}`
+}
+
+const clock = {
+  now: () => Date.now(),
+  every(tick: () => void) {
+    const timer = setInterval(tick, 1_000)
+    return () => clearInterval(timer)
+  },
+}
+
+/** The execution timestamp owns elapsed time; tool changes and renders never reset it. */
+export function createExecutionElapsed(input: Accessor<{ started?: number; active: boolean }>, time = clock) {
+  const [now, setNow] = createSignal(time.now())
+  createEffect(() => {
+    if (!input().active || input().started === undefined) return
+    setNow(time.now())
+    onCleanup(time.every(() => setNow(time.now())))
+  })
+  return createMemo(() => elapsedTime(input().started, now()))
+}
diff --git a/packages/tui/src/util/tool-changes.ts b/packages/tui/src/util/tool-changes.ts
new file mode 100644
index 0000000..607ff33
--- /dev/null
+++ b/packages/tui/src/util/tool-changes.ts
@@ -0,0 +1,62 @@
+import { finiteNumber } from "./tool-display"
+import { isRecord } from "./record"
+
+// A script's changes, like a patch's files, but a change may have no patch and, where nothing could be derived
+// without reading the file, no counts.
+export function parseScriptChanges(value: unknown) {
+  if (!Array.isArray(value)) return []
+  return value.flatMap((item) => {
+    const file = recordValue(item)
+    const status = stringValue(file?.status)
+    const type =
+      status === "added" ? "add" : status === "deleted" ? "delete" : status === "modified" ? "update" : undefined
+    const relativePath = stringValue(file?.file)
+    if (!file || !type || !relativePath) return []
+    return [
+      {
+        type,
+        relativePath,
+        filePath: relativePath,
+        patch: stringValue(file.patch) ?? "",
+        additions: finiteNumber(file.additions),
+        deletions: finiteNumber(file.deletions),
+        movePath: undefined as string | undefined,
+      },
+    ]
+  })
+}
+
+export function parseApplyPatchFiles(value: unknown) {
+  if (!Array.isArray(value)) return []
+  return value.flatMap((item) => {
+    const file = recordValue(item)
+    if (!file) return []
+    const status = stringValue(file.status)
+    const type =
+      stringValue(file.type) ??
+      (status === "added" ? "add" : status === "deleted" ? "delete" : status === "modified" ? "update" : undefined)
+    const relativePath = stringValue(file.file) ?? stringValue(file.relativePath)
+    const filePath = stringValue(file.filePath) ?? relativePath
+    const patch = stringValue(file.patch)
+    const additions = finiteNumber(file.additions)
+    const deletions = finiteNumber(file.deletions)
+    if (
+      !type ||
+      !relativePath ||
+      !filePath ||
+      patch === undefined ||
+      additions === undefined ||
+      deletions === undefined
+    )
+      return []
+    return [{ type, relativePath, filePath, patch, additions, deletions, movePath: stringValue(file.movePath) }]
+  })
+}
+
+function stringValue(value: unknown) {
+  return typeof value === "string" ? value : undefined
+}
+
+function recordValue(value: unknown): Record<string, unknown> | undefined {
+  return isRecord(value) ? value : undefined
+}
