+  expect(toolPreview(tool("patch", { patchText: "*** Begin Patch\n+line" }))?.text).toContain("+line")
+  expect(
+    toolPreview({ ...edit, state: { status: "error", input: {}, error: { type: "UnknownError", message: "denied" } } }),
+  ).toBeUndefined()
+})
