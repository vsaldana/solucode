+import { expect, test } from "bun:test"
+import { createRoot, createSignal } from "solid-js"
+import { createExecutionElapsed, elapsedTime, executionStart } from "../../src/util/execution-progress"
+
+test("hydrates the execution timestamp and replaces the old one before the session refresh arrives", () => {
+  expect(executionStart({ busy: 10, idle: 20 })).toBeUndefined()
+  expect(executionStart({ busy: 30, idle: 20 })).toBe(30)
+  expect(executionStart({ busy: 10, idle: 20 }, 50)).toBe(50)
+  expect(executionStart({ busy: 30, idle: 20 }, 50)).toBe(50)
+  expect(elapsedTime(undefined, 5_000)).toBe("--:--")
+  expect(elapsedTime(6_000, 5_000)).toBe("0:00")
+  expect(elapsedTime(0, 3_661_000)).toBe("61:01")
+})
+
+test("elapsed time survives tool updates, session switches and remount; idle and disposal stop the clock", async () => {
+  let now = 65_000
+  const timers = new Set<() => void>()
+  const clock = {
+    now: () => now,
+    every(tick: () => void) {
+      timers.add(tick)
+      return () => {
+        timers.delete(tick)
+      }
+    },
+  }
+  const mount = () =>
+    createRoot((dispose) => {
+      const [input, setInput] = createSignal<{ started?: number; active: boolean }>({ started: 5_000, active: true })
+      return { dispose, setInput, elapsed: createExecutionElapsed(input, clock) }
+    })
+  const scope = mount()
