diff --git a/packages/tui/src/prompt/suggestion.ts b/packages/tui/src/prompt/suggestion.ts
new file mode 100644
index 0000000..dbda87a
--- /dev/null
+++ b/packages/tui/src/prompt/suggestion.ts
@@ -0,0 +1,88 @@
+import type { SessionMessageInfo } from "@opencode/client"
+
+export function suggestionTurn(messages: readonly SessionMessageInfo[]) {
+  const idle = messages.at(-1)
+  if (idle?.type !== "idle" || idle.outcome !== "succeeded") return
+  const last = messages.at(-2)
+  if (last?.type !== "assistant" || !last.time.completed || last.error || last.finish !== "stop") return
+  const index = messages.findLastIndex((message) => message.type === "user")
+  const user = messages[index]
+  if (user?.type !== "user" || !user.text.trim()) return
+  const answer = last.content
+    .flatMap((part) => (part.type === "text" ? [part.text] : []))
+    .join("\n")
+    .trim()
+  if (!answer) return
+  return {
+    key: last.id,
+    model: last.model,
+    // Only the latest exchange: no files, tool output, reasoning or entire history.
+    prompt: JSON.stringify({ entrada: user.text.slice(0, 3000), respuesta: answer.slice(-5000) }),
+  }
+}
+
+export function cleanSuggestion(text: string) {
+  const value = text
+    .trim()
+    .replace(/^["“]|["”]$/g, "")
+    .trim()
+  if (!value || value === "SIN_SUGERENCIA" || value.length > 240 || /[\r\n\x00-\x1f\x7f]/.test(value)) return
+  // Suggestions are editable prose, never slash commands or shell-mode shortcuts.
+  if (/^[\/!`]/.test(value)) return
+  return value
+}
+
+export type SuggestionTurn = NonNullable<ReturnType<typeof suggestionTurn>> & { sessionID: string }
+
+/** Owns one attempt per observed turn and cancels when the composer changes. */
+export function createSuggestion(input: {
+  generate: (turn: SuggestionTurn, signal: AbortSignal) => Promise<string>
+  show: (text: string | undefined) => void
+}) {
+  let controller: AbortController | undefined
+  let attempted: string | undefined
+  let session: string | undefined
+  let running = false
+
+  function dismiss() {
+    controller?.abort()
+    controller = undefined
+    input.show(undefined)
+  }
+
+  return {
+    dismiss,
+    update(state: { sessionID?: string; running: boolean; eligible: boolean; turn?: SuggestionTurn }) {
+      if (session !== state.sessionID) {
+        dismiss()
+        session = state.sessionID
+        attempted = undefined
+        running = false
+      }
+      if (state.running) running = true
+      if (!state.eligible || state.running) {
+        dismiss()
+        if (!state.running && state.turn) {
+          attempted = state.turn.key
+          running = false
+        }
+        return
+      }
+      const turn = state.turn
+      if (!running || !turn || attempted === turn.key) return
+      dismiss()
+      running = false
+      attempted = turn.key
+      const request = new AbortController()
+      controller = request
+      const timeout = setTimeout(() => request.abort(), 15_000)
+      void input
+        .generate(turn, request.signal)
+        .then((text) => {
+          if (controller === request && !request.signal.aborted) input.show(cleanSuggestion(text))
+        })
+        .catch(() => {}) // An optional suggestion must never interrupt the conversation.
+        .finally(() => clearTimeout(timeout))
+    },
+  }
+}
