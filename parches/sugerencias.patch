+    fetch: async (url, request) => {
+      if (url.pathname === "/api/session") return json({ data: [session], cursor: {} })
+      if (url.pathname === `/api/session/${session.id}`) return json({ data: session })
+      if (url.pathname === `/api/session/${session.id}/message`)
+        return json({ data: messages.toReversed(), cursor: {} })
+      if (url.pathname === `/api/session/${session.id}/inbox`) {
+        if (request.method === "POST") sent++
+        return json({ data: [] })
+      }
+      if (url.pathname === "/api/session/active") return json({ data: running ? { [session.id]: {} } : {} })
+      if (url.pathname === "/api/experimental/generate/text") {
+        requested.resolve(await request.json())
+        return json({ data: { text: "Agrega una prueba para el caso vacío." } })
+      }
+    },
+  })
+  await setup.ready
+  await setup.waitForFrame((frame) => frame.includes("Revisa el cambio") && !!setup.renderer.currentFocusedEditor)
+  running = false
+  setup.events.emit({
+    id: "evt_done",
+    type: "session.execution.succeeded",
+    durable: { aggregateID: session.id, seq: 10, version: 1 },
+    created: 3,
+    data: { sessionID: session.id },
+  })
+  expect(await requested.promise).toMatchObject({
+    model: { providerID: "router", id: "normal" },
+    experimental: { solucodeSuggestion: { sessionID: session.id } },
+  })
+  await setup.waitForFrame((frame) => frame.includes("Tab/→: aceptar"))
+  const editor = setup.renderer.currentFocusedEditor!
+  expect(editor.plainText).toBe("")
+  setup.mockInput.pressKey("TAB")
+  expect(editor.plainText).toBe("Agrega una prueba para el caso vacío.")
+  expect(sent).toBe(0)
+  await setup.mockInput.typeText(" Incluye nulos.")
+  expect(editor.plainText).toContain("Incluye nulos.")
+  expect(sent).toBe(0)
+  await setup.renderOnce()
+  expect(setup.captureCharFrame()).not.toContain("Tab/→: aceptar")
+})
diff --git a/packages/tui/test/prompt/suggestion.test.ts b/packages/tui/test/prompt/suggestion.test.ts
new file mode 100644
index 0000000..39a1110
--- /dev/null
+++ b/packages/tui/test/prompt/suggestion.test.ts
@@ -0,0 +1,115 @@
+import { expect, test } from "bun:test"
+import type { SessionMessageInfo } from "@opencode/client"
+import { cleanSuggestion, createSuggestion, suggestionTurn, type SuggestionTurn } from "../../src/prompt/suggestion"
+
+const model = { providerID: "router", id: "normal" }
+const user: SessionMessageInfo = { id: "msg_user", type: "user", text: "Revisa el cambio", time: { created: 1 } }
+const assistant: SessionMessageInfo = {
+  id: "msg_answer",
+  type: "assistant",
+  agent: "build",
+  model,
+  content: [{ type: "text", text: "Falta probar el caso vacío." }],
+  finish: "stop",
+  time: { created: 1, completed: 2 },
+}
+const idle: SessionMessageInfo = { id: "msg_idle", type: "idle", outcome: "succeeded", time: { created: 3 } }
+const turn: SuggestionTurn = { key: "msg_answer", sessionID: "ses_one", model, prompt: "intercambio" }
+
+test("solo usa un intercambio finalizado y limita su contexto", () => {
+  const result = suggestionTurn([user, assistant, idle])!
+  expect(result.model).toEqual(model)
+  expect(JSON.parse(result.prompt)).toEqual({ entrada: user.text, respuesta: "Falta probar el caso vacío." })
+  expect(suggestionTurn([user])).toBeUndefined()
+  for (const finish of ["length", "tool-calls", "error", "content-filter", "unknown"] as const) {
+    expect(suggestionTurn([user, { ...assistant, finish }, idle])).toBeUndefined()
+  }
+  expect(suggestionTurn([user, { ...assistant, time: { created: 1 } }, idle])).toBeUndefined()
+  const bounded = suggestionTurn([{ ...user, text: "u".repeat(20_000) }, assistant, idle])!
+  expect(JSON.parse(bounded.prompt).entrada.length).toBe(3000)
+})
+
+test("descarta comandos, controles, respuestas largas y ausencia de sugerencia", () => {
+  for (const text of ["", "SIN_SUGERENCIA", "/deploy", "!rm", "`code`", "dos\nlíneas", "a\x1bb", "x".repeat(241)]) {
+    expect(cleanSuggestion(text)).toBeUndefined()
+  }
+  expect(cleanSuggestion(" “Agrega una prueba para el caso vacío.” ")).toBe("Agrega una prueba para el caso vacío.")
+})
+
+function fixture() {
+  const calls: {
+    turn: SuggestionTurn
+    signal: AbortSignal
+    response: ReturnType<typeof Promise.withResolvers<string>>
+  }[] = []
+  let visible: string | undefined
+  const controller = createSuggestion({
+    show: (text) => {
+      visible = text
+    },
+    generate: (turn, signal) => {
+      const response = Promise.withResolvers<string>()
+      calls.push({ turn, signal, response })
+      return response.promise
+    },
+  })
+  const update = (eligible = true, running = false, next = turn) =>
+    controller.update({ sessionID: next.sessionID, eligible, running, turn: next })
+  return { calls, controller, update, visible: () => visible }
+}
+
+test("una llamada por turno observado, sin generar al abrir un historial", async () => {
+  const f = fixture()
+  f.update()
+  expect(f.calls).toHaveLength(0)
+  f.update(true, true)
+  f.update()
+  f.update()
+  expect(f.calls).toHaveLength(1)
+  f.calls[0].response.resolve("Prueba el caso vacío.")
+  await f.calls[0].response.promise
+  expect(f.visible()).toBe("Prueba el caso vacío.")
+  f.controller.dismiss()
+  f.update()
+  expect(f.calls).toHaveLength(1)
+  expect(f.visible()).toBeUndefined()
+})
+
+test.each(["borrador", "cambio de sesión", "otro turno"])("ignora una respuesta tardía tras %s", async (change) => {
+  const f = fixture()
+  f.update(true, true)
+  f.update()
+  if (change === "borrador") f.update(false)
+  if (change === "cambio de sesión") f.update(true, false, { ...turn, sessionID: "ses_two" })
+  if (change === "otro turno") f.update(true, true)
+  expect(f.calls[0].signal.aborted).toBe(true)
+  f.calls[0].response.resolve("Texto antiguo")
+  await f.calls[0].response.promise
+  expect(f.visible()).toBeUndefined()
+  f.controller.dismiss()
+})
+
+test("no genera al borrar un borrador que existía cuando terminó la respuesta", () => {
+  const f = fixture()
+  f.update(true, true)
+  f.update(false)
+  f.update()
+  expect(f.calls).toHaveLength(0)
+})
+
+test("fallo opcional no se reintenta ni se muestra", async () => {
+  const f = fixture()
+  f.update(true, true)
+  f.update()
+  f.calls[0].response.reject(new Error("503"))
+  await f.calls[0].response.promise.catch(() => {})
+  f.update()
+  expect(f.calls).toHaveLength(1)
+  expect(f.visible()).toBeUndefined()
+  f.controller.dismiss()
+})
+
+test("no confunde una ejecución fallida con el último mensaje antiguo completado", () => {
+  expect(suggestionTurn([user, assistant])).toBeUndefined()
+  expect(suggestionTurn([user, assistant, { ...idle, outcome: "interrupted" }])).toBeUndefined()
+})
