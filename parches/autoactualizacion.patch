+
+function zip(
+  entries = [
+    ["solucode.exe", "MZfixture"],
+    ["LICENSE", "MIT"],
+    ["NOTICE", "OpenCode"],
+  ],
+) {
+  const files: Buffer[] = []
+  const directory: Buffer[] = []
+  let offset = 0
+  for (const [name, content] of entries) {
+    const bytes = Buffer.from(content)
+    const local = Buffer.alloc(30 + name.length)
+    local.writeUInt32LE(0x04034b50)
+    local.writeUInt32LE(crc32(bytes), 14)
+    local.writeUInt32LE(bytes.length, 18)
+    local.writeUInt32LE(bytes.length, 22)
+    local.writeUInt16LE(name.length, 26)
+    local.write(name, 30)
+    const central = Buffer.alloc(46 + name.length)
+    central.writeUInt32LE(0x02014b50)
+    central.writeUInt32LE(crc32(bytes), 16)
+    central.writeUInt32LE(bytes.length, 20)
+    central.writeUInt32LE(bytes.length, 24)
+    central.writeUInt16LE(name.length, 28)
+    central.writeUInt32LE(offset, 42)
+    central.write(name, 46)
+    files.push(local, bytes)
+    directory.push(central)
+    offset += local.length + bytes.length
+  }
+  const end = Buffer.alloc(22)
+  end.writeUInt32LE(0x06054b50)
+  end.writeUInt16LE(entries.length, 8)
+  end.writeUInt16LE(entries.length, 10)
+  end.writeUInt32LE(
+    directory.reduce((size, entry) => size + entry.length, 0),
+    12,
+  )
+  end.writeUInt32LE(offset, 16)
+  return Buffer.concat([...files, ...directory, end])
+}
+const hash = (data: Uint8Array) => createHash("sha256").update(data).digest("hex")
+
+test("verifies SHA256 before reading the ZIP and rejects corrupt or unexpected contents", () => {
+  const bytes = zip()
+  expect(Buffer.from(SolucodeUpdater.verify(bytes, hash(bytes))).toString()).toBe("MZfixture")
+  expect(() => SolucodeUpdater.verify(bytes, "0".repeat(64))).toThrow("SHA256")
+  for (const bad of [
+    zip([
+      ["../solucode.exe", "MZ"],
+      ["LICENSE", "MIT"],
+      ["NOTICE", "OC"],
+    ]),
+    zip([
+      ["solucode.exe", "MZ"],
+      ["solucode.exe", "MZ"],
+      ["NOTICE", "OC"],
+    ]),
+    zip([
+      ["solucode.exe", "shell script"],
+      ["LICENSE", "MIT"],
+      ["NOTICE", "OC"],
+    ]),
+    bytes.subarray(0, bytes.length - 1),
+  ])
+    expect(() => SolucodeUpdater.verify(bad, hash(bad))).toThrow()
+  const damaged = Buffer.from(bytes)
+  damaged[45] ^= 1
+  expect(() => SolucodeUpdater.verify(damaged, hash(damaged))).toThrow()
+})
+
+test("restores the old executable when replacement cannot be activated", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "solucode-recovery-"))
