+import { NodeFileSystem } from "@effect/platform-node"
+import { expect, test } from "bun:test"
+import { Effect } from "effect"
+import fs from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+import { SolucodeService } from "../src/services/solucode-service"
+import { Flock } from "@opencode/util/flock"
+
+test("service attachments retry a contended lock and a waiting client can cancel", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "solucode-service-lock-"))
+  const file = path.join(root, "service.json")
+  const lease = await Flock.acquire("solucode-service", { dir: path.join(root, "locks") })
+  const controller = new AbortController()
+  let called = false
+  try {
+    const waiting = Effect.runPromise(
+      SolucodeService.lock(
+        file,
+        Effect.sync(() => {
+          called = true
+        }),
+      ),
+      { signal: controller.signal },
+    )
+    // Exercise a real acquisition timeout, then cancel while the other process still owns the lock.
+    const cancel = setTimeout(() => controller.abort(), 750)
+    await expect(waiting).rejects.toThrow()
+    clearTimeout(cancel)
+    expect(called).toBe(false)
+    await lease.release()
+    await Effect.runPromise(
+      SolucodeService.lock(
+        file,
+        Effect.sync(() => {
+          called = true
+        }),
+      ),
+    )
+    expect(called).toBe(true)
+  } finally {
+    await lease.release().catch(() => {})
+    await fs.rm(root, { recursive: true, force: true })
+  }
+})
+
+test("a reopened client keeps the previous service while another client, session or job is active", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "solucode-service-busy-"))
+  const file = path.join(root, "service.json")
+  // A dedicated child makes an accidental replacement kill only this fixture, never the test runner or user.
+  const script = path.join(root, "server.ts")
+  await fs.writeFile(
+    script,
+    `
+let state = "sessions"
+const server = Bun.serve({port:0, fetch(request) {
+  const url = new URL(request.url)
+  if (url.pathname === "/state") { state = url.searchParams.get("value"); return new Response("ok") }
+  if (state === "unready") return new Response("starting", {status:503})
+  if (url.pathname === "/api/session/active") return Response.json({data: state === "sessions" ? {"ses_fixture": {type:"running"}} : {}})
+  if (url.pathname === "/api/experimental/job") return Response.json({data: state === "jobs" ? [{id:"fixture",kind:"shell",sessionID:"ses_fixture",status:"running",time:{started:1},shellID:"shell",command:"fixture"}] : []})
+  return Response.json({version:"2.4.2-solucode.2", pid:process.pid, urls:[]})
+}})
+console.log(server.url.toString())
+for await (const _ of Bun.stdin.stream()) {}
+server.stop(true)
+`,
+  )
+  const child = Bun.spawn([process.execPath, script], {
+    stdin: "pipe",
+    stdout: "pipe",
+    stderr: "pipe",
+    windowsHide: true,
+  })
+  const reader = child.stdout.getReader()
+  try {
+    const url = new TextDecoder().decode((await reader.read()).value).trim()
+    await fs.writeFile(file, JSON.stringify({ url, pid: child.pid, version: "2.4.2-solucode.2" }))
+    const options = { file, version: "2.4.2-solucode.3", command: ["must-never-start"] }
+    const run = (clients: () => Promise<boolean>) =>
+      Effect.runPromise(
+        SolucodeService.lock(file, SolucodeService.ensure(options, clients)).pipe(Effect.provide(NodeFileSystem.layer)),
+      )
+    expect((await run(async () => false)).url).toBe(url)
+    await fetch(`${url}state?value=jobs`)
+    expect((await run(async () => false)).url).toBe(url)
+    await fetch(`${url}state?value=idle`)
+    expect((await run(async () => true)).url).toBe(url)
+    expect(
+      (
+        await run(async () => {
+          throw new Error("inspection unavailable")
+        })
+      ).url,
+    ).toBe(url)
+    await fetch(`${url}state?value=unready`)
+    await expect(run(async () => true)).rejects.toThrow("servicio anterior")
+    await expect(run(async () => false)).rejects.toThrow("servicio anterior")
+    await fetch(`${url}state?value=idle`)
+    expect((await fetch(url)).ok).toBe(true)
+    // Once every client and call is idle, replacement is permitted (the fixture command intentionally fails).
+    await expect(run(async () => false)).rejects.toThrow()
+    expect(await child.exited).not.toBeNull()
+  } finally {
+    reader.releaseLock()
+    if (child.exitCode === null) child.stdin.end()
+    await child.exited
+    await fs.rm(root, { recursive: true, force: true })
+  }
+})
