+}
+
+test("accepts only the exact SOLUCODE repository, version, asset and SHA256", () => {
+  expect(SolucodeUpdater.manifest(approved)).toEqual(approved)
+  for (const update of [
+    { version: "2.4.2" },
+    { version: "2.4.2-solucode.03" },
+    { version: "v2.4.2-solucode.3" },
