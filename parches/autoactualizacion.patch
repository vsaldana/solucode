+    const executable = path.join(root, "solucode.exe")
+    const candidate = path.join(root, "candidate.exe")
+    await fs.copyFile(process.env.SOLUCODE_TEST_PREVIOUS_EXE!, executable)
+    await fs.copyFile(executable, candidate)
+    await fs.appendFile(candidate, "solucode-release-test")
+    const original = hash(await fs.readFile(executable))
+    expect(original).toBe("325e1531ed5957730f2f37e3e2dfc77eed8c7331df501bb6e52d4ca46f523eba")
+    const expected = hash(await fs.readFile(candidate))
+    const child = Bun.spawn([executable, "serve", "--stdio", "--port", "0", "--hostname", "127.0.0.1"], {
+      cwd: root,
+      windowsHide: true,
+      stdin: "pipe",
+      stdout: "pipe",
+      stderr: "pipe",
+      env: isolatedEnv(root, {
+        USERPROFILE: root,
+        LOCALAPPDATA: path.join(root, "local"),
+        ProgramData: path.join(root, "program-data"),
+        PROGRAMDATA: path.join(root, "program-data"),
+        OPENCODE_PASSWORD: "release-test-only",
+        OPENCODE_DISABLE_AUTOUPDATE: "1",
+      }),
+    })
+    const stderr = new Response(child.stderr).text()
+    const reader = child.stdout.getReader()
+    try {
+      let output = ""
+      let url: string | undefined
+      while (!url) {
+        const next = await reader.read()
+        if (next.done) throw new Error(await stderr)
+        output += new TextDecoder().decode(next.value)
+        const line = output.split(/\r?\n/).find((line) => line.startsWith('{"url":'))
+        if (line) url = JSON.parse(line).url
+      }
+      const info = async () => {
+        const response = await fetch(`${url}/api/info`, {
+          headers: { Authorization: `Basic ${Buffer.from("opencode:release-test-only").toString("base64")}` },
+          signal: AbortSignal.timeout(5_000),
+        })
+        expect(response.ok).toBe(true)
+        return (await response.json()) as { version: string; pid: number }
+      }
+      const before = await info()
+      await expect(
+        Effect.runPromise(
+          SolucodeUpdater.replace(path.join(root, "missing.exe"), executable).pipe(
+            Effect.provide(NodeFileSystem.layer),
+          ),
+        ),
+      ).rejects.toThrow()
+      expect(hash(await fs.readFile(executable))).toBe(original)
+      expect((await info()).pid).toBe(child.pid)
+      await Effect.runPromise(SolucodeUpdater.replace(candidate, executable).pipe(Effect.provide(NodeFileSystem.layer)))
+      expect(hash(await fs.readFile(executable))).toBe(expected)
+      const after = await info()
+      expect(after.pid).toBe(child.pid)
+      expect(after.version).toBe(before.version)
+      expect(await SolucodeUpdater.binaryVersion(executable)).toBe("2.4.2")
+    } finally {
+      reader.releaseLock()
+      if (child.exitCode === null) child.stdin.end()
+      await child.exited
+      await stderr
+      await fs.rm(root, { recursive: true, force: true })
+    }
+  },
+)
