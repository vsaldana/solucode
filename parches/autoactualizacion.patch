index 0000000..3224ef5
--- /dev/null
+++ b/packages/cli/src/services/solucode-archive.ts
@@ -0,0 +1,42 @@
+import { crc32, inflateRawSync } from "node:zlib"
+
+/** Read only the three flat files published by the SOLUCODE build, never archive paths. */
+export function executableFromZip(input: Uint8Array) {
+  const zip = Buffer.from(input.buffer, input.byteOffset, input.byteLength)
+  const end = zip.length - 22
+  if (end < 0 || zip.readUInt32LE(end) !== 0x06054b50) throw new Error("ZIP de SOLUCODE inválido")
+  if (zip.readUInt32LE(end + 4) !== 0 || zip.readUInt16LE(end + 8) !== 3 || zip.readUInt16LE(end + 10) !== 3)
+    throw new Error("El ZIP debe contener exactamente tres archivos")
+  const offset = zip.readUInt32LE(end + 16)
+  if (offset + zip.readUInt32LE(end + 12) !== end) throw new Error("Directorio ZIP inválido")
+  const names = new Set(["solucode.exe", "LICENSE", "NOTICE"])
+  let entry = offset
+  let executable: Uint8Array | undefined
+  for (let index = 0; index < 3; index++) {
+    if (zip.readUInt32LE(entry) !== 0x02014b50) throw new Error("Entrada ZIP inválida")
+    const flags = zip.readUInt16LE(entry + 8)
+    const method = zip.readUInt16LE(entry + 10)
+    const compressed = zip.readUInt32LE(entry + 20)
+    const length = zip.readUInt32LE(entry + 24)
+    const nameLength = zip.readUInt16LE(entry + 28)
+    const name = zip.subarray(entry + 46, entry + 46 + nameLength).toString("utf8")
+    const local = zip.readUInt32LE(entry + 42)
+    if (!names.delete(name) || flags & 1 || (method !== 0 && method !== 8) || length > 512 * 1024 * 1024)
+      throw new Error("Contenido ZIP no permitido")
+    if (zip.readUInt32LE(local) !== 0x04034b50 || zip.readUInt16LE(local + 8) !== method)
+      throw new Error("Cabecera ZIP inválida")
+    const start = local + 30 + zip.readUInt16LE(local + 26) + zip.readUInt16LE(local + 28)
+    if (start + compressed > offset) throw new Error("Archivo ZIP truncado")
+    const content =
+      method === 0
+        ? zip.subarray(start, start + compressed)
+        : inflateRawSync(zip.subarray(start, start + compressed), { maxOutputLength: Math.max(1, length) })
+    if (content.length !== length || crc32(content) !== zip.readUInt32LE(entry + 16))
+      throw new Error("Archivo ZIP corrupto")
+    if (name === "solucode.exe") executable = content
+    entry += 46 + nameLength + zip.readUInt16LE(entry + 30) + zip.readUInt16LE(entry + 32)
+  }
+  if (entry !== end || !executable || executable[0] !== 0x4d || executable[1] !== 0x5a)
+    throw new Error("El ZIP no contiene un ejecutable Windows válido")
+  return executable
+}
diff --git a/packages/cli/src/services/solucode-service.ts b/packages/cli/src/services/solucode-service.ts
new file mode 100644
index 0000000..9e016f4
--- /dev/null
+++ b/packages/cli/src/services/solucode-service.ts
@@ -0,0 +1,112 @@
+export * as SolucodeService from "./solucode-service"
+
+import { Service, type EnsureOptions } from "@opencode/client/effect/service"
+import { OpenCode } from "@opencode/client/promise"
+import { Flock } from "@opencode/util/flock"
+import { Effect, FileSystem, Option, Schedule, Schema } from "effect"
+import path from "node:path"
+
+/** Serialize new attachments with replacement so another new CLI cannot attach during the idle check. */
+class ServiceLockBusy extends Error {}
+export const lock = <A, E, R>(file: string, effect: Effect.Effect<A, E, R>) =>
+  Effect.acquireUseRelease(
+    Effect.tryPromise((signal) =>
+      Flock.acquire("solucode-service", {
+        dir: path.join(path.dirname(file), "locks"),
+        signal,
+        timeoutMs: 500,
+        maxDelayMs: 100,
+      }),
+    ).pipe(
+      Effect.mapError((cause) =>
+        cause.cause instanceof Error && cause.cause.message.startsWith("Timed out waiting for lock:")
+          ? new ServiceLockBusy(cause.cause.message)
+          : cause,
+      ),
+    ),
+    () => effect,
+    (lease) => Effect.promise(() => lease.release()),
+  ).pipe(
+    Effect.retry({
+      // Each acquisition is bounded; between attempts cancellation can close a waiting TUI immediately.
+      while: (cause) => cause instanceof ServiceLockBusy,
+      schedule: Schedule.spaced("100 millis").pipe(Schedule.upTo({ duration: "2 minutes" })),
+    }),
+  )
+
+/** Inspect native processes only on a version mismatch, including clients from releases without lease files. */
+export async function otherClients() {
+  const script = `$ErrorActionPreference = 'Stop'
+$clients = @(Get-CimInstance Win32_Process -Filter "Name = 'solucode.exe' OR Name = 'opencode.exe' OR Name LIKE 'opencode-%'" | Where-Object {
+  $_.ProcessId -ne [int]$env:SOLUCODE_UPDATE_PID -and
+  (!$_.CommandLine -or $_.CommandLine -notmatch '\\bserve\\s+--service\\b')
+})
+if ($clients.Count -gt 0) { 'busy' } else { 'idle' }`
+  const child = Bun.spawn(["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script], {
+    windowsHide: true,
+    env: { ...process.env, SOLUCODE_UPDATE_PID: String(process.pid) },
+    stdout: "pipe",
+    stderr: "pipe",
+    signal: AbortSignal.timeout(15_000),
+  })
+  const [text, , code] = await Promise.all([
+    new Response(child.stdout).text(),
+    new Response(child.stderr).text(),
+    child.exited,
+  ])
+  return code !== 0 || text.trim() !== "idle"
+}
+
+export const ensure = Effect.fnUntraced(function* (
+  options: EnsureOptions,
+  clients: () => Promise<boolean> = otherClients,
+) {
+  const fs = yield* FileSystem.FileSystem
+  const registered = options.file ? yield* fs.exists(options.file).pipe(Effect.orElseSucceed(() => true)) : false
+  const registration = options.file
+    ? yield* fs
+        .readFileString(options.file)
+        .pipe(Effect.flatMap(Schema.decodeUnknownEffect(Schema.fromJsonString(Service.Info))), Effect.option)
+    : Option.none()
+  const compatible = yield* Service.discover(options)
+  if (compatible) return compatible
+  const existing = yield* Service.discover({ ...options, version: undefined })
+  const attached = yield* Effect.tryPromise(clients).pipe(Effect.orElseSucceed(() => true))
+  if (!existing) {
+    const alive =
+      Option.isSome(registration) &&
+      (yield* Effect.try({
+        try: () => {
+          process.kill(registration.value.pid, 0)
+          return true
+        },
+        catch: (cause) => cause,
+      }).pipe(
+        Effect.catch((cause) => Effect.succeed(!(cause instanceof Error && "code" in cause && cause.code === "ESRCH"))),
+      ))
+    // A failed health check is not permission to kill an old service that still owns calls.
+    if (alive || (registered && Option.isNone(registration)))
+      return yield* Effect.fail(
+        new Error(
+          "El servicio anterior de SOLUCODE todavía está iniciando o no responde; vuelve a intentar sin cerrar tus otras sesiones",
+        ),
+      )
+    return yield* Service.ensure(options)
+  }
+  const client = OpenCode.make({ baseUrl: existing.url, headers: Service.headers(existing) })
+  const busy = yield* Effect.tryPromise(async () => {
+    if (attached) return true
+    const [sessions, jobs] = await Promise.all([
+      client.session.active({ signal: AbortSignal.timeout(5_000) }),
+      client.experimental.job.list({ status: "running" }, { signal: AbortSignal.timeout(5_000) }),
+    ])
+    return Object.keys(sessions).length > 0 || jobs.length > 0
+  }).pipe(Effect.orElseSucceed(() => true))
+  if (busy) {
+    process.stderr.write(
+      "SOLUCODE actualizado. El servicio anterior sigue activo para no interrumpir otras sesiones; se renovará al reabrir cuando estén libres.\n",
+    )
+    return existing
+  }
+  return yield* Service.ensure(options)
+})
diff --git a/packages/cli/src/services/solucode-updater.ts b/packages/cli/src/services/solucode-updater.ts
new file mode 100644
index 0000000..afc5345
--- /dev/null
+++ b/packages/cli/src/services/solucode-updater.ts
@@ -0,0 +1,215 @@
+export * as SolucodeUpdater from "./solucode-updater"
+
+import { Global } from "@opencode/util/global"
+import { EffectFlock } from "@opencode/util/effect-flock"
+import { Effect, FileSystem, Option, Ref, Schema } from "effect"
+import { createHash, randomBytes } from "node:crypto"
+import path from "node:path"
+import { OPENCODE_LOCAL, OPENCODE_VERSION } from "../version"
+import { RetainedImage } from "./retained-image"
+import { executableFromZip } from "./solucode-archive"
+import { decodePolicy, type CheckResult, type Interface, type RunResult } from "./updater"
+
+export const manifestURL = "https://router.conversus.digital/solucode/actualizacion.json"
+const releaseRoot = "https://github.com/vsaldana/solucode/releases/download/"
+const Manifest = Schema.Struct({ version: Schema.String, url: Schema.String, sha256: Schema.String })
+export type Manifest = typeof Manifest.Type
+const decodeManifest = Schema.decodeUnknownSync(Manifest)
+
+export function manifest(input: unknown): Manifest {
+  const value = decodeManifest(input)
+  if (!/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)-solucode\.(0|[1-9]\d*)$/.test(value.version))
+    throw new Error("Versión SOLUCODE inválida")
+  if (value.url !== `${releaseRoot}v${value.version}/solucode-windows-x64.zip`)
+    throw new Error("La actualización no pertenece al release aprobado de SOLUCODE")
+  if (!/^[a-f0-9]{64}$/.test(value.sha256)) throw new Error("SHA256 inválido")
+  return value
+}
+
+export function installed(executable = process.execPath, local = process.env.LOCALAPPDATA) {
+  return (
+    local !== undefined &&
+    path.resolve(executable).toLowerCase() === path.resolve(local, "solucode", "solucode.exe").toLowerCase()
+  )
+}
+
+/** Numeric SOLUCODE revision ordering, including .10 after .9; bare versions are legacy .0. */
+export function newer(candidate: string, current: string) {
+  const parts = (version: string) =>
+    /^(\d+)\.(\d+)\.(\d+)(?:-solucode\.(\d+))?$/
+      .exec(version)
+      ?.slice(1)
+      .map((part) => BigInt(part ?? "0"))
+  const next = parts(candidate)
+  const previous = parts(current)
+  if (!next || !previous) return false
+  const index = next.findIndex((part, index) => part !== previous[index])
+  return index !== -1 && next[index] > previous[index]
+}
+
+export async function binaryVersion(executable: string) {
+  const child = Bun.spawn([executable, "--version"], {
+    stdout: "pipe",
+    stderr: "pipe",
+    windowsHide: true,
+    signal: AbortSignal.timeout(30_000),
+  })
+  const [stdout, stderr, code] = await Promise.all([
+    new Response(child.stdout).text(),
+    new Response(child.stderr).text(),
+    child.exited,
+  ])
+  const version = /^solucode v(\d+\.\d+\.\d+(?:-solucode\.\d+)?)\s/.exec(stdout.trim())?.[1]
+  if (code !== 0 || !version) throw new Error(`No se pudo validar la versión del ejecutable: ${stderr.slice(-500)}`)
+  return version
+}
+
+export function verify(bytes: Uint8Array, expected: string) {
+  if (createHash("sha256").update(bytes).digest("hex") !== expected)
+    throw new Error("El SHA256 de la descarga no coincide con el aprobado por el router")
+  return executableFromZip(bytes)
+}
+
+const error = (cause: unknown) => (cause instanceof Error ? cause : new Error(String(cause)))
+
+export const make = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem
+  const global = yield* Global.Service
+  const flock = yield* EffectFlock.Service
+  const current = yield* Ref.make(OPENCODE_VERSION)
+  const executable = path.resolve(process.execPath)
+  const directory = path.dirname(executable)
+  const eligible = !OPENCODE_LOCAL && process.platform === "win32" && installed()
+  const unavailable =
+    "Para actualizar SOLUCODE, vuelve a correr: irm https://router.conversus.digital/instalar.ps1 | iex"
+  const approved = () =>
+    Effect.tryPromise({
+      try: async (signal) => {
+        const response = await fetch(manifestURL, {
+          signal: AbortSignal.any([signal, AbortSignal.timeout(30_000)]),
+          redirect: "error",
+          cache: "no-store",
+        })
+        if (!response.ok) throw new Error(`No se pudo consultar la versión aprobada (${response.status})`)
+        const text = await response.text()
+        if (text.length > 4096) throw new Error("Manifiesto demasiado grande")
+        return manifest(JSON.parse(text))
+      },
+      catch: error,
+    })
+  const policy = Effect.fnUntraced(function* () {
+    const files = [
+      ...["config.json", "opencode.json", "opencode.jsonc"].map((name) => path.join(global.config, name)),
+      path.join(process.env.ProgramData ?? "C:\\ProgramData", "opencode", "opencode.jsonc"),
+    ]
+    const values = yield* Effect.forEach(files, (file) =>
+      fs.readFileString(file).pipe(
+        Effect.map(decodePolicy),
+        Effect.orElseSucceed(() => undefined),
+      ),
+    )
+    return values.findLast((value) => value !== undefined) ?? "auto"
+  })
+  const apply = Effect.fn("solucode.updater.apply")(function* (version: string) {
+    if (!eligible) return yield* Effect.fail(new Error(unavailable))
+    yield* Effect.scoped(
+      Effect.gen(function* () {
+        // Another TUI may be downloading. Never hold this TUI's shutdown waiting for that installation.
+        yield* flock.acquire("cli-upgrade", undefined, { timeoutMs: 500 })
+        // Re-fetch under the install lock: a previous dialog must not install a withdrawn release.
+        const release = yield* approved()
+        if (version !== release.version)
+          return yield* Effect.fail(new Error("La versión aprobada cambió; vuelve a comprobarla"))
+        const previous = yield* Effect.tryPromise({ try: () => binaryVersion(executable), catch: error })
+        if (!newer(version, previous)) {
+          yield* Ref.set(current, previous)
+          return
+        }
+        const stage = yield* fs.makeTempDirectoryScoped({ directory, prefix: ".solucode-update-" })
+        const bytes = yield* Effect.tryPromise({
+          try: async (signal) => {
+            const response = await fetch(release.url, {
+              signal: AbortSignal.any([signal, AbortSignal.timeout(5 * 60_000)]),
+            })
+            if (!response.ok) throw new Error(`No se pudo descargar SOLUCODE (${response.status})`)
+            if (Number(response.headers.get("content-length")) > 512 * 1024 * 1024)
+              throw new Error("Descarga demasiado grande")
+            const data = new Uint8Array(await response.arrayBuffer())
+            if (data.length > 512 * 1024 * 1024) throw new Error("Descarga demasiado grande")
+            return verify(data, release.sha256)
+          },
+          catch: error,
+        })
+        const candidate = path.join(stage, "solucode.exe")
+        yield* fs.writeFile(candidate, bytes)
+        const built = yield* Effect.tryPromise({ try: () => binaryVersion(candidate), catch: error })
+        if (built !== release.version)
+          return yield* Effect.fail(new Error("La versión del ejecutable no coincide con el manifiesto"))
+        const retained = yield* RetainedImage.retain(directory, "upgrade")
+        if (!retained)
+          return yield* Effect.fail(new Error("No se pudo conservar el ejecutable en uso; se reintentará más tarde"))
+        yield* replace(candidate, executable)
+        yield* Ref.set(current, version)
+      }),
+    ).pipe(Effect.provideService(FileSystem.FileSystem, fs), Effect.mapError(error))
+  })
+  const check = Effect.fn("solucode.updater.check")(function* (): Effect.fn.Return<CheckResult | undefined, Error> {
+    if (!eligible) return { type: "unavailable", message: unavailable }
+    const release = yield* approved()
+    const version = yield* Ref.get(current)
+    if (newer(release.version, version)) return { type: "available", version: release.version }
+    if (version !== OPENCODE_VERSION) return { type: "installed", version }
+  })
+  const run: Interface["run"] = (onInstall = () => {}) =>
+    Effect.gen(function* () {
+      if (!eligible || ["1", "true"].includes((process.env.OPENCODE_DISABLE_AUTOUPDATE ?? "").toLowerCase())) return
+      const mode = yield* policy()
+      if (mode === "disable") return
+      const result = yield* check()
+      if (!result || result.type !== "available") return result?.type === "installed" ? result : undefined
+      if (mode === "notify") return result
+      onInstall(result.version)
+      yield* apply(result.version)
+      return { type: "installed", version: yield* Ref.get(current) } satisfies RunResult
+    }).pipe(
+      Effect.catch((cause) =>
+        Effect.logWarning("No se pudo actualizar SOLUCODE; se reintentará", { cause }).pipe(Effect.as(undefined)),
+      ),
+    )
+  return {
+    run,
+    check,
+    apply,
+    latest: () => approved().pipe(Effect.map((value) => value.version)),
+    upgrade: (_method: unknown, version: string) => apply(version),
+  }
+})
+
+/** Keep the old image recoverable until the complete replacement occupies the canonical path. */
+export const replace = Effect.fnUntraced(function* (candidate: string, executable: string) {
+  const fs = yield* FileSystem.FileSystem
+  const backup = path.join(
+    path.dirname(executable),
+    `opencode-upgrade-${process.pid}-${randomBytes(4).toString("hex")}.exe`,
+  )
+  // Windows can replace a plain runtime atomically, but Bun's compiled bundle keeps its file mapped.
+  // Renaming that image first is supported; never interrupt the promotion or its rollback halfway through.
+  yield* Effect.uninterruptible(
+    Effect.gen(function* () {
+      yield* fs.link(executable, backup)
+      const result = yield* fs.rename(candidate, executable).pipe(Effect.option)
+      if (Option.isNone(result)) {
+        yield* fs.remove(backup)
+        yield* fs.rename(executable, backup)
+        const promoted = yield* fs.rename(candidate, executable).pipe(Effect.option)
+        if (Option.isNone(promoted)) {
+          yield* fs.rename(backup, executable)
+          return yield* Effect.fail(
+            new Error("Windows no permitió activar la actualización; se conservó la versión anterior"),
+          )
+        }
+      }
+      yield* fs.remove(backup).pipe(Effect.ignore)
+    }),
+  )
+})
